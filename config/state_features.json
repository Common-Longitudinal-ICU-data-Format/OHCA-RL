{
  "_description": "Curated state feature schema for OHCA-RL DDQN+CQL. Common subset across federated sites (UCMC, NU, Rush). Both training and validation read from this file; sites that lack a column zero-fill (rare) but the intent is upstream pipeline produces all listed columns.",
  "_dropped_from_full_ucmc_set": [
    "lab_troponin_t — Rush charts troponin_i instead",
    "assess_rass — Rush patient_assessments table lacks RASS",
    "med_cont_clevidipine — not charted at Rush or NU",
    "med_cont_isoproterenol — not charted at Rush",
    "med_cont_lorazepam — Rush has lorazepam as intermittent only",
    "med_cont_angiotensin_prev — Rush has no angiotensin in continuous meds"
  ],
  "n_features": 64,
  "state_features": [
